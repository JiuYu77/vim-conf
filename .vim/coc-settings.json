{
  "snippets.ultisnips.pythonPrompt": false,
  "snippets.ultisnips.usePythonx": true,
  "http.proxy": "http://127.0.0.1:8889",
  "http.proxyStrictSSL": false,

  "clangd.path": "/lib/llvm-19/bin/clangd",
  "languageserver": {
    "clangd": {
      "command": "clangd",
      "rootPatterns": ["compile_flags.txt", "compile_commands.json", ".clangd"],
      "fileTypes": ["c", "cc", "cpp", "c++", "objc", "objcpp"],
      "args": [
        "--compile-commands-dir=.",
        "--header-insertion=never",
        "--query-driver=/usr/bin/g++",
        "--extra-arg=-std=c++17",
        "--extra-arg=-I/usr/include/c++/12",
        "--extra-arg=-I/usr/include/x86_64-linux-gnu/c++/12"
      ]
    }
  }

}
